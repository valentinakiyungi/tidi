# Copy this file to .env and fill in your values. Never share .env.

# ---- How Tidi alerts you ----
# ntfy     = push notifications in the free ntfy app (no Telegram needed)
# telegram = messages from a Telegram bot
NOTIFY_VIA=ntfy

# ntfy: leave NTFY_TOPIC empty and Tidi creates a private random topic
# and prints it when it starts. Then subscribe to it in the ntfy app.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=

# Telegram (only if NOTIFY_VIA=telegram): token from @BotFather
TELEGRAM_BOT_TOKEN=
# Send /start to your bot and it tells you this number
TELEGRAM_CHAT_ID=

# ---- AI provider ----
# gemini (free, recommended) | groq (free) | ollama (free, runs on your PC)
# claude | openai | openrouter (paid / mixed)
AI_PROVIDER=gemini
# Gemini key: https://aistudio.google.com/apikey
# Groq key:   https://console.groq.com/keys
# Ollama:     leave empty
AI_API_KEY=
# Optional: override the default model for your provider
AI_MODEL=

# ---- Schedule ----
# Check for new email every N hours (0 = only the morning brief)
CHECK_EVERY_HOURS=3
# Morning brief time, 24h, in your timezone (e.g. Africa/Nairobi, Europe/Moscow)
BRIEF_TIME=07:30
TIMEZONE=Africa/Dar_es_Salaam

# How far back to look for unread email
LOOKBACK_HOURS=24
MAX_EMAILS=50
# Emails sent to the AI per request (lower it if you hit free-tier limits)
BATCH_SIZE=8
# Max "Unsubscribe?" questions per morning
MAX_UNSUB_QUESTIONS=5

# Your name, used when drafting replies
YOUR_NAME=Valentina
